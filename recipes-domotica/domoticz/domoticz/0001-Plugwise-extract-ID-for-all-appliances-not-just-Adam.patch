From 905aa84be562d1f711aeaf68011beb6abe9c9a4c Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Sun, 24 Jan 2021 12:15:51 +0100
Subject: [PATCH 1/3] Plugwise: extract ID for all appliances, not just
 Adam/Anna

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>

Upstream-Status: Inappropriate [WIP]
---
 hardware/AnnaThermostat.cpp | 24 +++++++++++++++---------
 1 file changed, 15 insertions(+), 9 deletions(-)

diff --git a/hardware/AnnaThermostat.cpp b/hardware/AnnaThermostat.cpp
index 48151ac3d..95859d584 100644
--- a/hardware/AnnaThermostat.cpp
+++ b/hardware/AnnaThermostat.cpp
@@ -456,6 +456,20 @@ void CAnnaThermostat::GetMeterDetails()
 	while (pAppliance)
 	{
 		TiXmlHandle hAppliance = TiXmlHandle(pAppliance);
+		std::string applianceID = "";
+
+		pAttribute = pAppliance->FirstAttribute();
+		if (pAttribute != nullptr)
+		{
+			std::string aName = pAttribute->Name();
+			if (aName == "id")
+			{
+				applianceID = pAttribute->Value();
+				Log(LOG_NORM, "AnnaTherm: Appliance ID: %s", applianceID.c_str());
+			}
+		} else {
+			Log(LOG_ERROR, "AnnaTherm: Cannot find appliance ID");
+		}
 
 		pElem = pAppliance->FirstChildElement("name");
 		if (pElem == nullptr)
@@ -467,15 +481,7 @@ void CAnnaThermostat::GetMeterDetails()
 
 		if ((m_ThermostatID.empty()) && ((ApplianceName == "Anna") || (ApplianceName == "Adam")))
 		{
-			pAttribute = pAppliance->FirstAttribute();
-			if (pAttribute != nullptr)
-			{
-				std::string aName = pAttribute->Name();
-				if (aName == "id")
-				{
-					m_ThermostatID = pAttribute->Value();
-				}
-			}
+			m_ThermostatID = applianceID;
 		}
 
 		//Handle point_log
