From 5171f0b7b14f27ac0d2d3db57167bafbb9d646f5 Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Wed, 8 Jul 2026 19:21:53 +0200
Subject: [PATCH] Fix Philips Hue bridge registration with hidden port

When the Philips Hue hardware form hides the Port row, the Register on Bridge flow still required a non-empty port and failed with 'Please enter a Port'. Default to 443 in RegisterPhilipsHue when the field is empty so registration matches add/update behavior.

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>

Assisted-by: GPT-5.3-Codex
Upstream-Status: Inappropriate [WIP]
---
 www/app/hardware/Hardware.js | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/www/app/hardware/Hardware.js b/www/app/hardware/Hardware.js
index b4b0e4ee0..facd5fa95 100644
--- a/www/app/hardware/Hardware.js
+++ b/www/app/hardware/Hardware.js
@@ -5146,8 +5146,7 @@ define(['app'], function (app) {
 			}
 			var port = $("#hardwarecontent #divremote #tcpport").val();
 			if (port == "") {
-				ShowNotify($.t('Please enter an Port!'), 2500, true);
-				return;
+				port = 443;
 			}
 			var username = $("#hardwarecontent #hardwareparamsphilipshue #username").val();
 			$.ajax({
-- 
