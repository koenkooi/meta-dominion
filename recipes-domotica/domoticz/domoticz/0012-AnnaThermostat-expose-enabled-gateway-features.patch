From 31b06e614d7c25decfa452418ea5a12d4b3eece8 Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Wed, 8 Jul 2026 16:40:14 +0200
Subject: [PATCH 12/46] AnnaThermostat: expose enabled gateway features

Publish /core/gateways feature flags as switch devices so enabled capabilities are visible in Domoticz.

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>
Assisted-by: GPT-5.3-Codex

Upstream-Status: Inappropriate [WIP]
---
 hardware/AnnaThermostat.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/hardware/AnnaThermostat.cpp b/hardware/AnnaThermostat.cpp
index bcdf45949..9f461be89 100644
--- a/hardware/AnnaThermostat.cpp
+++ b/hardware/AnnaThermostat.cpp
@@ -610,6 +610,18 @@ void CAnnaThermostat::GetMeterDetails()
 						SendTextSensor(0xADA0, 10, 255, model, "Adam Gateway Model");
 					if (!firmware.empty())
 						SendTextSensor(0xADA0, 11, 255, firmware, "Adam Gateway Firmware");
+
+					TiXmlElement* pFeatures = pGw->FirstChildElement("features");
+					uint8_t featureChild = 20;
+					for (TiXmlElement* pFeature = pFeatures ? pFeatures->FirstChildElement() : nullptr;
+						 pFeature && featureChild < 120;
+						 pFeature = pFeature->NextSiblingElement(), ++featureChild)
+					{
+						const char* featureName = pFeature->Value();
+						if (!featureName || !*featureName)
+							continue;
+						SendSwitch(0xADA0, featureChild, 255, true, 0, std::string("Feature ") + featureName, m_Name);
+					}
 				}
 			}
 		}
