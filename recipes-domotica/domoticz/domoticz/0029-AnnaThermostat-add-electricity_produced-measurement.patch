From ead832d9d05e1dd0ff5b2779092e7835c0cfa782 Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Wed, 8 Jul 2026 16:58:00 +0200
Subject: [PATCH 29/50] AnnaThermostat: add electricity_produced measurement

Map electricity_produced to a Domoticz watt meter value in W.

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>
Assisted-by: GPT-5.3-Codex

Upstream-Status: Inappropriate [WIP]
---
 hardware/AnnaThermostat.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/hardware/AnnaThermostat.cpp b/hardware/AnnaThermostat.cpp
index 8dae0f672..7f7649b72 100644
--- a/hardware/AnnaThermostat.cpp
+++ b/hardware/AnnaThermostat.cpp
@@ -1336,6 +1336,15 @@ void CAnnaThermostat::GetMeterDetails()
 					SendWattMeter(applianceIDhex, 0, batterypercentage, plugusage, ApplianceName + " " + sname);
 				}
 			}
+			else if (sname == "electricity_produced")
+			{
+				if (!tmpstr.empty())
+				{
+					// Reported value is Wh per 15 minutes, approximate to W.
+					float plugproduction = (float)atof(tmpstr.c_str()) * 4.0F;
+					SendWattMeter(applianceIDhex, 1, batterypercentage, plugproduction, ApplianceName + " " + sname);
+				}
+			}
             else if (sname == "domestic_hot_water_temperature")
             {
                 if (!tmpstr.empty())
