+// Devices are looked up by the same DeviceID Domoticz's own decode_General()
+// builds for sTypeKwh devices: hex((NodeID<<8)|ChildID). NodeID==ChildID here,
+// matching the convention GetYearPower already uses for nodes 30/31.
+void CDaikin::RestoreUsageTotals()
+{
+	m_usageTotalsRestored = true;
+
+	char szTmp[20];
+	int nValue;
+	std::string sValue;
+	std::vector<std::string> parts;
+
+	sprintf(szTmp, "%08X", (unsigned int)((43 << 8) | 43));
+	struct tm totalLastUpdate {
+	};
+	if (m_sql.GetLastValue(m_HwdID, szTmp, 1, pTypeGeneral, sTypeKwh, nValue, sValue, totalLastUpdate))
+	{
+		parts.clear();
+		StringSplit(sValue, ";", parts);
+		if (parts.size() == 2)
+		{
+			m_totalUsageKwh = atof(parts[1].c_str()) / 1000.0; // stored in Wh, tracked here in kWh
+			// Avoids double-crediting the hour we may have restarted in the middle of.
+			m_lastDayPowerHour = totalLastUpdate.tm_hour;
+		}
+	}
+
+	sprintf(szTmp, "%08X", (unsigned int)((44 << 8) | 44));
+	struct tm heatLastUpdate {
+	};
+	if (m_sql.GetLastValue(m_HwdID, szTmp, 1, pTypeGeneral, sTypeKwh, nValue, sValue, heatLastUpdate))
+	{
+		parts.clear();
+		StringSplit(sValue, ";", parts);
+		if (parts.size() == 2)
+			m_heatUsageKwh = atof(parts[1].c_str()) / 1000.0;
+	}
+
+	sprintf(szTmp, "%08X", (unsigned int)((45 << 8) | 45));
+	struct tm coolLastUpdate {
+	};
+	if (m_sql.GetLastValue(m_HwdID, szTmp, 1, pTypeGeneral, sTypeKwh, nValue, sValue, coolLastUpdate))
+	{
+		parts.clear();
+		StringSplit(sValue, ";", parts);
+		if (parts.size() == 2)
+			m_coolUsageKwh = atof(parts[1].c_str()) / 1000.0;
+	}
+}
+
+// Ports daikin-usage.sh's hourly usage tracking: /aircon/get_day_power_ex
+// returns 24 "/"-joined hourly buckets (0.1kWh units) per curr_day_cool/
+// curr_day_heat. Bucket selection mirrors the script's awk field pick
+// (1-indexed by hour-of-day, falling back to field 24 at hour 0 -- i.e.
+// crediting the last hour of the day that just rolled over).
+void CDaikin::GetDayPower()
+{
+	if (!m_usageTotalsRestored)
+		RestoreUsageTotals();
+
+	time_t now = mytime(nullptr);
+	struct tm ltime;
+	localtime_r(&now, &ltime);
+
+	if (ltime.tm_hour == m_lastDayPowerHour)
+		return; // this hour's bucket was already credited
+
+	std::string sResult;
+	std::stringstream szURL;
+
+	if (m_Password.empty())
+	{
+		szURL << "http://" << m_szIPAddress << ":" << m_usIPPort;
+	}
+	else
+	{
+		szURL << "http://" << m_Username << ":" << m_Password << "@" << m_szIPAddress << ":" << m_usIPPort;
+	}
+
+	szURL << "/aircon/get_day_power_ex";
+	if (!HTTPClient::GET(szURL.str(), sResult))
+	{
+		Log(LOG_ERROR, "Error connecting to: %s", m_szIPAddress.c_str());
+		return;
+	}
+
+	if (sResult.find("ret=OK") == std::string::npos)
+	{
+		Log(LOG_ERROR, "Error getting data (check IP/Port)");
+		return;
+	}
+	std::vector<std::string> results;
+	StringSplit(sResult, ",", results);
+	if (results.size() < 4)
+	{
+		Log(LOG_ERROR, "Invalid data received");
+		return;
+	}
+
+	size_t bucket = (ltime.tm_hour > 0) ? (size_t)ltime.tm_hour : 24;
+
+	double coolDeltaKwh = 0;
+	double heatDeltaKwh = 0;
+	bool haveCool = false;
+	bool haveHeat = false;
+
+	for (const auto &sVar : results)
+	{
+		std::vector<std::string> results2;
+		StringSplit(sVar, "=", results2);
+		if (results2.size() != 2)
+			continue;
+		if (results2[0] == "curr_day_cool")
+		{
+			std::vector<std::string> hours;
+			StringSplit(results2[1], "/", hours);
+			if (bucket <= hours.size())
+			{
+				coolDeltaKwh = std::stof(hours[bucket - 1]) / 10; // energy saved as 0.1 kWh units
+				haveCool = true;
+			}
+		}
+		else if (results2[0] == "curr_day_heat")
+		{
+			std::vector<std::string> hours;
+			StringSplit(results2[1], "/", hours);
+			if (bucket <= hours.size())
+			{
+				heatDeltaKwh = std::stof(hours[bucket - 1]) / 10;
+				haveHeat = true;
+			}
+		}
+	}
+
+	if (!haveCool && !haveHeat)
+		return;
+
+	m_lastDayPowerHour = ltime.tm_hour;
+
+	m_totalUsageKwh += coolDeltaKwh + heatDeltaKwh;
+	m_heatUsageKwh += heatDeltaKwh;
+	m_coolUsageKwh += coolDeltaKwh;
+
+	// musage carries this hour's delta in Wh, matching daikin-usage.sh's
+	// convention of publishing the hourly delta as the "instant" value --
+	// it isn't a real Watt reading, but keeps the existing Grafana panel
+	// that reads it (tag name "Daikin-usage") working unchanged.
+	SendKwhMeter(43, 43, 255, (coolDeltaKwh + heatDeltaKwh) * 1000.0, m_totalUsageKwh, "Daikin usage");
+	SendKwhMeter(44, 44, 255, heatDeltaKwh * 1000.0, m_heatUsageKwh, "Daikin heat usage");
+	SendKwhMeter(45, 45, 255, coolDeltaKwh * 1000.0, m_coolUsageKwh, "Daikin cool usage");
+}
