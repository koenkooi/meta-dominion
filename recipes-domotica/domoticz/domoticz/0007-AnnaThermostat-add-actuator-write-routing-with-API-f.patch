+
+bool CAnnaThermostat::PutControlFunctionality(const ControlTarget& target, const std::string& endpointWithType, const std::string& payload)
+{
+	if (!CheckLoginData() || target.collection.empty() || target.objectId.empty() || endpointWithType.empty())
+		return false;
+
+	std::stringstream szURLBase;
+	if (m_Password.empty())
+		szURLBase << "http://" << m_IPAddress << ":" << m_IPPort;
 	else
+		szURLBase << "http://" << m_UserName << ":" << m_Password << "@" << m_IPAddress << ":" << m_IPPort;
+
+	const std::string url = szURLBase.str() + "/core/" + target.collection + ";id=" + target.objectId + "/" + endpointWithType;
+	std::vector<std::string> extraHeaders;
+	std::string result;
+	const bool ok = HTTPClient::PUT(url, payload, extraHeaders, result, true);
+	(void)result;
+	return ok;
+}
+
+bool CAnnaThermostat::PutToggleFunctionality(const ControlTarget& target, bool isOn)
+{
+	const char* stateValue = isOn ? "on" : "off";
+	const std::string typePart = target.type.empty() ? "" : ";type=" + target.type;
+
+	std::stringstream legacyPayload;
+	legacyPayload << "<toggle><state>" << stateValue << "</state></toggle>";
+	if (target.endpoint == "toggle" && PutControlFunctionality(target, "toggle" + typePart, legacyPayload.str()))
+		return true;
+
+	std::stringstream payload;
+	payload << "<toggle_functionality><state>" << stateValue << "</state></toggle_functionality>";
+	if (PutControlFunctionality(target, "toggle_functionality" + typePart, payload.str()))
+		return true;
+
+	return PutControlFunctionality(target, "toggle" + typePart, legacyPayload.str());
+}
+
+bool CAnnaThermostat::PutRelayFunctionality(const ControlTarget& target, bool isOn)
+{
+	const char* stateValue = isOn ? "on" : "off";
+	const std::string typePart = target.type.empty() ? "" : ";type=" + target.type;
