+	const int keyId = idx & 0xFF;
+	{
+		std::lock_guard<std::mutex> lock(m_StateMutex);
+		thermostatId = m_ThermostatID;
+		for (const auto& entry : m_SetpointTargets)
+		{
+			const int32_t key = entry.first;
+			const int32_t keyIdLowByte = (key >> 8) & 0xFF;
+			const int32_t keyUnit = key & 0xFF;
+			if (keyIdLowByte == keyId && keyUnit == 1)
+				targets.insert(targets.end(), entry.second.begin(), entry.second.end());
+		}
+	}
 
-	if (m_Password.empty())
+	if (!targets.empty())
 	{
-		szURL << "http://" << m_IPAddress << ":" << m_IPPort;
+		bool allSucceeded = true;
+		for (const auto& target : targets)
+		{
+			if (!PutThermostatFunctionality(target, temp))
+			{
+				allSucceeded = false;
+			}
+		}
+		if (allSucceeded)
+			return;
 	}
+
+	if (thermostatId.empty())
+	{
+		return;
+	}
+
+	ControlTarget target;
+	target.collection = "appliances";
+	target.objectId = thermostatId;
+	target.endpoint = "thermostat";
