+		const int32_t nodeId = (static_cast<int32_t>(pCmd->LIGHTING2.id1) << 24)
+			| (static_cast<int32_t>(pCmd->LIGHTING2.id2) << 16)
+			| (static_cast<int32_t>(pCmd->LIGHTING2.id3) << 8)
+			| static_cast<int32_t>(pCmd->LIGHTING2.id4);
+		bool isOn = false;
+		if (pCmd->LIGHTING2.cmnd == light2_sOn)
+			isOn = true;
+		else if (pCmd->LIGHTING2.cmnd == light2_sOff)
+			isOn = false;
+		else
+			return false;
+
+		if (nodeId == sAnnaBoilerState || nodeId == sAnnaFlameState)
 		{
 			return false; // just return Error as these are not supposed to be switches
 		}
-		if (node_id == sAnnaProximity)
+		if (nodeId == sAnnaProximity)
+		{
+			return AnnaToggleProximity(isOn);
+		}
+
+		const int32_t key = (nodeId << 8) | static_cast<int32_t>(pCmd->LIGHTING2.unitcode & 0xFF);
+		return writeSwitchTarget(key, isOn);
+	}
+	else if (packettype == pTypeSetpoint)
+	{
+		const _tSetpoint* pSetpoint = reinterpret_cast<const _tSetpoint*>(pdata);
+		const int32_t applianceHex = (static_cast<int32_t>(pSetpoint->id3) << 8) | static_cast<int32_t>(pSetpoint->id4);
+		const int32_t key = (applianceHex << 8) | static_cast<int32_t>(pSetpoint->dunit);
+		std::vector<ControlTarget> targets;
 		{
-			return AnnaToggleProximity(bIsOn);
+			std::lock_guard<std::mutex> lock(m_StateMutex);
+			auto it = m_SetpointTargets.find(key);
+			if (it != m_SetpointTargets.end())
+				targets = it->second;
+		}
+		if (!targets.empty())
+		{
+			Log(LOG_NORM, "AnnaTherm: Setpoint write key=%04X unit=%u targets=%zu value=%.2f", applianceHex, static_cast<unsigned int>(pSetpoint->dunit), targets.size(), pSetpoint->value);
+			bool attempted = false;
+			bool allSucceeded = true;
+			for (const auto& target : targets)
+			{
+				attempted = true;
+				Log(LOG_NORM, "AnnaTherm: Setpoint target %s %s endpoint=%s type=%s", target.collection.c_str(), target.objectId.c_str(), target.endpoint.c_str(), target.type.c_str());
+				if (!PutThermostatFunctionality(target, pSetpoint->value))
+				{
+					allSucceeded = false;
+					Log(LOG_ERROR, "AnnaTherm: Failed setpoint write for %s %s", target.collection.c_str(), target.objectId.c_str());
+				}
+			}
+			return attempted && allSucceeded;
 		}
+
+		// Legacy fallback path for the original thermostat setpoint device.
+		Log(LOG_NORM, "AnnaTherm: Setpoint key=%04X unit=%u has no mapped targets, using legacy fallback", applianceHex, static_cast<unsigned int>(pSetpoint->dunit));
+		SetSetpoint(0, pSetpoint->value);
+		return true;
 	}
 	else if (packettype == pTypeGeneralSwitch)
 	{
 		const _tGeneralSwitch* xcmd = reinterpret_cast<const _tGeneralSwitch*>(pdata);
-		return AnnaSetPreset(xcmd->level);
+		if (xcmd->id == sAnnaPresets)
+		{
+			return AnnaSetPreset(xcmd->level);
+		}
+
+		bool isOn = false;
+		if (xcmd->cmnd == gswitch_sOn || xcmd->cmnd == gswitch_sGroupOn)
+			isOn = true;
+		else if (xcmd->cmnd == gswitch_sOff || xcmd->cmnd == gswitch_sGroupOff)
+			isOn = false;
+		else if (xcmd->cmnd == gswitch_sSetLevel || xcmd->cmnd == gswitch_sSetGroupLevel)
+			isOn = (xcmd->level > 0);
+		else
+			return false;
+
+		const int32_t key = (xcmd->id << 8) | (xcmd->unitcode & 0xFF);
+		return writeSwitchTarget(key, isOn);
 	}
 	return false;
 }
 
