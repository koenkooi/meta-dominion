From 50c40767ea25189cf59ed962f57953df315ca2a9 Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Sun, 27 Apr 2025 15:52:19 +0200
Subject: [PATCH 13/50] AnnaThermostat: add support for valve_position

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>
Upstream-Status: Inappropriate [WIP]
---
 hardware/AnnaThermostat.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/hardware/AnnaThermostat.cpp b/hardware/AnnaThermostat.cpp
index 264d35f28..2a8a93ac6 100644
--- a/hardware/AnnaThermostat.cpp
+++ b/hardware/AnnaThermostat.cpp
@@ -1283,6 +1283,15 @@ void CAnnaThermostat::GetMeterDetails()
                     SendHumiditySensor(applianceIDhex, 255, humidity, ApplianceName + " " + sname);
                 }
             }
+	    else if (sname == "valve_position")
+            {
+                tmpstr = GetPeriodMeasurement(pElem);
+                if (!tmpstr.empty())
+                {
+                    float valveposition = (float)atof(tmpstr.c_str()) * 100;
+                    SendPercentageSensor(applianceIDhex, 0, 255, valveposition, ApplianceName + " " + sname);
+                }
+            }
         }
         pAppliance = pAppliance->NextSiblingElement("appliance");
     }
-- 
