From 197a1514672142f89814e947c25bacaceb7a4d6c Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Wed, 8 Jul 2026 16:17:49 +0200
Subject: [PATCH 21/50] AnnaThermostat: add support for relay state

Parse relay state and publish it as an on/off switch sensor.

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>
Assisted-by: GPT-5.3-Codex

Upstream-Status: Inappropriate [WIP]
---
 hardware/AnnaThermostat.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/hardware/AnnaThermostat.cpp b/hardware/AnnaThermostat.cpp
index b86cf637e..13ab75329 100644
--- a/hardware/AnnaThermostat.cpp
+++ b/hardware/AnnaThermostat.cpp
@@ -721,6 +721,7 @@ void CAnnaThermostat::GetMeterDetails()
 	}
 	std::unordered_map<int32_t, ControlTarget> newSwitchTargets;
 	std::unordered_map<int32_t, std::vector<ControlTarget>> newSetpointTargets;
+	std::unordered_map<unsigned int, std::unordered_set<uint8_t>> relayControlChildren;
 	std::string discoveredThermostatId;
 	std::string discoveredProximityId;
 
@@ -845,6 +846,7 @@ void CAnnaThermostat::GetMeterDetails()
 				ControlTarget target{ locationId.empty() ? "appliances" : "locations", locationId.empty() ? applianceID : locationId, "relay", functionType };
 				const int32_t key = (static_cast<int32_t>(applianceIDhex) << 8) | static_cast<int32_t>(controlledChild);
 				newSwitchTargets[key] = target;
+				relayControlChildren[applianceIDhex].insert(controlledChild);
 			}
 			else if (functionName == "toggle_functionality")
 			{
@@ -1183,6 +1185,20 @@ void CAnnaThermostat::GetMeterDetails()
 					SendSwitch(applianceIDhex, 8, batterypercentage, isOn, 0, ApplianceName + " " + sname, m_Name);
 				}
 			}
+			else if (sname == "relay")
+			{
+				if (!tmpstr.empty())
+				{
+					auto relayIt = relayControlChildren.find(applianceIDhex);
+					const bool hasRelayControl = relayIt != relayControlChildren.end() && !relayIt->second.empty();
+					const bool relayChildNineIsControllable = hasRelayControl && relayIt->second.count(9) != 0;
+					if (hasRelayControl && !relayChildNineIsControllable)
+						continue;
+
+					bool isOn = (strcmp(tmpstr.c_str(), "on") == 0);
+					SendSwitch(applianceIDhex, 9, batterypercentage, isOn, 0, ApplianceName + " " + sname, m_Name);
+				}
+			}
             else if (sname == "central_heater_water_pressure")
             {
                 if (!tmpstr.empty())
-- 
