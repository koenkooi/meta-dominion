From ca7b5181a9e4f1c8570e18ae2ff5ffaf093b80c3 Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Wed, 8 Jul 2026 16:39:28 +0200
Subject: [PATCH 08/46] AnnaThermostat: add Hub API v3 endpoint fallbacks

Prefer modern Plugwise Hub API endpoints (/core/domain_objects and /core/locations) while preserving legacy endpoint fallbacks for older firmware.

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>
Assisted-by: GPT-5.3-Codex

Upstream-Status: Inappropriate [WIP]
---
 hardware/AnnaThermostat.cpp | 36 +++++++++++++++++++++++-------------
 1 file changed, 23 insertions(+), 13 deletions(-)

diff --git a/hardware/AnnaThermostat.cpp b/hardware/AnnaThermostat.cpp
index e4fe2f874..705260916 100644
--- a/hardware/AnnaThermostat.cpp
+++ b/hardware/AnnaThermostat.cpp
@@ -39,7 +39,9 @@
 
 const std::string ANNA_VERSION       = "1.0.1";
 const std::string ANNA_GET_STATUS    = "/core/appliances";
+const std::string ANNA_GET_STATUS_NEW = "/core/domain_objects";
 const std::string ANNA_LOCATION      = "/cache/domain_objects;class=Location";
+const std::string ANNA_LOCATION_NEW  = "/core/locations";
 const std::string ANNA_SET_LOCATION  = "/core/locations";
 const std::string ANNA_LEVEL_NAMES   = "Off|Home|Away|Night|Vacation|Frost";
 const std::string ANNA_LEVEL_ACTIONS = "00|10|20|30|40|50";
@@ -410,20 +412,20 @@ void CAnnaThermostat::GetMeterDetails()
 #ifdef DEBUG_AnnaThermostat
 	sResult = ReadFile(DEBUG_ANNA_APPLIANCE_READ);
 #else
-	//Get Data
-	std::stringstream szURL;
+	// Prefer the newer domain_objects endpoint and fall back to legacy appliances.
+	std::stringstream szURLBase;
 
 	if (m_Password.empty())
 	{
-		szURL << "http://" << m_IPAddress << ":" << m_IPPort;
+		szURLBase << "http://" << m_IPAddress << ":" << m_IPPort;
 	}
 	else
 	{
-		szURL << "http://" << m_UserName << ":" << m_Password << "@" << m_IPAddress << ":" << m_IPPort;
+		szURLBase << "http://" << m_UserName << ":" << m_Password << "@" << m_IPAddress << ":" << m_IPPort;
 	}
-	szURL << ANNA_GET_STATUS;
 
-	if (!HTTPClient::GET(szURL.str(), sResult))
+	const std::string base = szURLBase.str();
+	if (!HTTPClient::GET(base + ANNA_GET_STATUS_NEW, sResult) && !HTTPClient::GET(base + ANNA_GET_STATUS, sResult))
 	{
 		Log(LOG_ERROR, "AnnaTherm: Error getting current state!");
 		return;
@@ -448,6 +450,10 @@ void CAnnaThermostat::GetMeterDetails()
 
 	pRoot = doc.FirstChildElement("appliances");
 	if (!pRoot)
+	{
+		pRoot = doc.FirstChildElement("domain_objects");
+	}
+	if (!pRoot)
 	{
 		Log(LOG_ERROR, "AnnaTherm: Cannot find appliances in XML");
 		return;
@@ -778,20 +784,20 @@ bool CAnnaThermostat::AnnaGetLocation()
 #ifdef DEBUG_AnnaThermostat
 	sResult = ReadFile(DEBUG_ANNA_LOCATION_READ);
 #else
-	//Get Location  Data
-	std::stringstream szURL;
+	// Prefer /core/locations and fall back to the legacy cache endpoint.
+	std::stringstream szURLBase;
 
 	if (m_Password.empty())
 	{
-		szURL << "http://" << m_IPAddress << ":" << m_IPPort;
+		szURLBase << "http://" << m_IPAddress << ":" << m_IPPort;
 	}
 	else
 	{
-		szURL << "http://" << m_UserName << ":" << m_Password << "@" << m_IPAddress << ":" << m_IPPort;
+		szURLBase << "http://" << m_UserName << ":" << m_Password << "@" << m_IPAddress << ":" << m_IPPort;
 	}
-	szURL << ANNA_LOCATION;
 
-	if (!HTTPClient::GET(szURL.str(), sResult))
+	const std::string base = szURLBase.str();
+	if (!HTTPClient::GET(base + ANNA_LOCATION_NEW, sResult) && !HTTPClient::GET(base + ANNA_LOCATION, sResult))
 	{
 		Log(LOG_ERROR, "AnnaTherm: Error getting location Info !");
 		return false;
@@ -814,7 +820,11 @@ bool CAnnaThermostat::AnnaGetLocation()
 	TiXmlAttribute* pAttribute;
 	std::string sname, tmpstr;
 
-	pRoot = doc.FirstChildElement("domain_objects");
+	pRoot = doc.FirstChildElement("locations");
+	if (!pRoot)
+	{
+		pRoot = doc.FirstChildElement("domain_objects");
+	}
 	if (!pRoot)
 	{
 		Log(LOG_ERROR, "AnnaTherm: Cannot find domain info in XML");
