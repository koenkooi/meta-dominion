+// Phoenixtec binary framing protocol, RS-232 9600 8N1.
+// Full spec: aeg-inverter/PROTOCOL.md
+// Probe session (confirmed field values from live unit): aeg-inverter/PROBE_SESSION.md
+//
+// Frame wire format:
+//   AA AA | src(2 BE) | dst(2 BE) | opcode(2 BE) | len(1) | payload(len) | checksum(2 BE)
+//
+// Checksum: sum of *all* bytes in the frame including the AA AA preamble, mod 65536.
+//
+// Pre-handshake (before serial confirm): dst = 0x0000
+// After serial confirm:                  dst = 0x0001 (host-assigned inverter address)
+
+namespace {
+
+// Wire addresses
+constexpr uint16_t ADDR_HOST          = 0x0100;
+constexpr uint16_t ADDR_INVERTER_PRE  = 0x0000; // before serial confirm
+constexpr uint16_t ADDR_INVERTER      = 0x0001; // after serial confirm
+
+// Opcodes (host → inverter)
+constexpr uint16_t OP_INIT            = 0x0004; // bus reset, no reply
+constexpr uint16_t OP_SERIAL_QUERY    = 0x0000;
+constexpr uint16_t OP_SERIAL_CONFIRM  = 0x0001;
+constexpr uint16_t OP_VERSION         = 0x0103;
+constexpr uint16_t OP_PARAMFMT        = 0x0101;
+constexpr uint16_t OP_PARAMS          = 0x0104;
+constexpr uint16_t OP_DATAFMT         = 0x0100;
+constexpr uint16_t OP_DATA            = 0x0102;
+
+// Opcodes (inverter → host, response opcodes)
+constexpr uint16_t RSP_SERIAL         = 0x0080;
+constexpr uint16_t RSP_SERIAL_CONFIRM = 0x0081;
+constexpr uint16_t RSP_VERSION        = 0x0183;
+constexpr uint16_t RSP_PARAMFMT       = 0x0181;
+constexpr uint16_t RSP_PARAMS         = 0x0184;
+constexpr uint16_t RSP_DATAFMT        = 0x0180;
+constexpr uint16_t RSP_DATA           = 0x0182;
+
+// Data field codes (from config.ini / PROTOCOL.md §6)
+constexpr uint8_t FIELD_TEMP          = 0x00;
+constexpr uint8_t FIELD_ETODAY        = 0x0D;
+constexpr uint8_t FIELD_VPV           = 0x40;
+constexpr uint8_t FIELD_IAC           = 0x41;
+constexpr uint8_t FIELD_VAC           = 0x42;
+constexpr uint8_t FIELD_FAC           = 0x43;
+constexpr uint8_t FIELD_PAC           = 0x44;
+constexpr uint8_t FIELD_ZAC           = 0x45;
+constexpr uint8_t FIELD_ETOTALH       = 0x47;
+constexpr uint8_t FIELD_ETOTALL       = 0x48;
+constexpr uint8_t FIELD_HTOTALH       = 0x49;
+constexpr uint8_t FIELD_HTOTALL       = 0x4A;
+constexpr uint8_t FIELD_MODE          = 0x4C;
+constexpr uint8_t FIELD_ERR_GV        = 0x78;
+constexpr uint8_t FIELD_ERR_GF        = 0x79;
+constexpr uint8_t FIELD_ERR_GZ        = 0x7A;
+constexpr uint8_t FIELD_ERR_TEMP      = 0x7B;
+constexpr uint8_t FIELD_ERR_PV1       = 0x7C;
+constexpr uint8_t FIELD_ERR_GFC1      = 0x7D;
+constexpr uint8_t FIELD_ERR_MODE      = 0x7E;
+
+// ZAC = 0xFFFF means "not measured" on this hardware.
+constexpr uint16_t ZAC_SENTINEL       = 0xFFFF;
+
+// Retry / timing constants
+constexpr int RETRY_DELAY_SECS        = 30;
+constexpr int REPLY_TIMEOUT_SECS      = 5;  // per handshake step
+constexpr int HEARTBEAT_INTERVAL      = 12; // seconds between heartbeat ticks
+
+// Version payload layout (64 bytes), from live-capture byte analysis (PROBE_SESSION.md):
+//   [0..6]    capacity prefix "1  2800"
+//   [7..14]   firmware string "S1.00   "
+//   [15..30]  model string " PV2800         " (leading space, stripped by TrimField)
+//   [31..43]  manufacturer " Phoenixtec  " (leading space, stripped)
+//   [44..53]  three trailing spaces + serial start — serial is at [45..54], use
+//             m_inverterSerialBytes (from serial query) instead to avoid offset fragility.
+constexpr size_t VER_OFF_FIRMWARE     = 7;
+constexpr size_t VER_LEN_FIRMWARE     = 8;
+constexpr size_t VER_OFF_MODEL        = 15;
+constexpr size_t VER_LEN_MODEL        = 16;
+constexpr size_t VER_OFF_MANUF        = 31;
+constexpr size_t VER_LEN_MANUF        = 13;
+
+// Operating mode codes → human-readable labels
+const char* ModeName(uint16_t mode)
+{
+	switch (mode)
+	{
+		case 0:  return "Waiting";
+		case 1:  return "Normal";
+		case 2:  return "Fault";
+		case 3:  return "Permanent fault";
+		default: return "Unknown";
+	}
+}
+
+} // anonymous namespace
