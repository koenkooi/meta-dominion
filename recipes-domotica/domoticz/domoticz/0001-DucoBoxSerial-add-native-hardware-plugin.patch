+	std::map<std::string, int> m_filterDropCounters;
+	std::string m_lastTopologySignature;
+	int m_networkFailStreak = 0;
+
+	// Stuck-RH-sensor tracking (see docs/duco-api-reference.md): a hardware fault
+	// occasionally latches the raw (centi-percent) HUM_SENSOR_VAL reading, which
+	// then drives the fan hard trying to satisfy a phantom humidity level. Real
+	// readings -- even during a plateaued real shower -- still show a few raw
+	// units of ADC jitter poll to poll; only bit-exact equality over a sustained
+	// window is treated as a fault, since high-and-briefly-steady is completely
+	// normal (validated against 6 months of history: naive rounded-percent and
+	// fan-near-max heuristics both fire constantly on ordinary shower use).
+	struct StuckHumidityTracker
+	{
+		int lastRawValue = -1;
+		time_t sameSince = 0;
+	};
+	std::map<int, StuckHumidityTracker> m_rhStuckTracker;
+	std::map<int, time_t> m_pendingOverruleRelease;
+	std::map<int, time_t> m_lastStuckRemediation;
+};
