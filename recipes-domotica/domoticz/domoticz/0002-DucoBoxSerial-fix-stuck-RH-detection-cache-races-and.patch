From d609aeb3b5b702e0c542f623393c136a23d5ed50 Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Fri, 17 Jul 2026 10:27:12 +0200
Subject: [PATCH 02/46] DucoBoxSerial: fix stuck-RH detection, cache races, and
 error reporting

The stuck-humidity heuristic previously required the raw reading to
be latched AND at least 80%. Real hardware faults can latch a valve
RH sensor at any level, not just a high one, so drop the percent
floor entirely and trigger on a bit-exact-flat raw reading alone
(validated against 6 months of Influx history for the duration
threshold). Fix the tracker -1 sentinel, which collided with a
genuinely possible raw value and could instant-trigger on the first
poll after startup, with an explicit hasValue flag instead.

Add a mutex around m_nodeCapacityM3h/m_nodeAutoMaxPercent: they are
written from PublishNodeConfig() on either the poll thread or the
Domoticz worker thread (via WriteToHardware), and were read
unsynchronized from PollCycle()/TrackAndMaybeRemediateStuckHumidity().

CheckPendingOverruleReleases() no longer drops a node from the
pending-release map when the release command fails -- it retries next
cycle instead of silently abandoning the node in manual override.

SendCommand() final fallback now reports failure when every retry is
exhausted without a completion marker, rather than treating any
non-empty reply as success -- a garbled partial reply (e.g. async log
frames interleaved right as a command was sent) could previously come
back as a false "success".

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>

Assisted-by: claude:claude-sonnet-5 [Bash] [Edit]
Upstream-Status: Inappropriate [WIP]
---
 hardware/DucoBoxSerial.cpp | 62 +++++++++++++++++++++++++++++---------
 hardware/DucoBoxSerial.h   | 15 ++++++++-
 2 files changed, 61 insertions(+), 16 deletions(-)

diff --git a/hardware/DucoBoxSerial.cpp b/hardware/DucoBoxSerial.cpp
index 66df4dea5..34ff02435 100644
--- a/hardware/DucoBoxSerial.cpp
+++ b/hardware/DucoBoxSerial.cpp
@@ -79,10 +79,10 @@ namespace
 	const int DUCO_MAX_HUMIDITY = 100;
 
 	// Stuck-RH-sensor remediation (see docs/duco-api-reference.md and
-	// DucoBoxSerial.h). Thresholds are deliberately conservative: validated against
-	// 6 months of real Influx history, a shorter/looser window fires constantly on
-	// ordinary shower-driven humidity plateaus.
-	const int DUCO_RH_STUCK_MIN_PERCENT = 80;
+	// DucoBoxSerial.h). Duration threshold validated against 6 months of real
+	// Influx history: a shorter window fires constantly on ordinary
+	// shower-driven humidity plateaus. Deliberately no minimum-percent floor --
+	// a faulty valve's raw reading can latch at any level, not just a high one.
 	const time_t DUCO_RH_STUCK_MIN_DURATION_SECONDS = 20 * 60;
 	const time_t DUCO_RH_STUCK_OVERRULE_HOLD_SECONDS = 60;
 	const time_t DUCO_RH_STUCK_COOLDOWN_SECONDS = 60 * 60;
@@ -410,10 +410,16 @@ void CDucoBoxSerial::PollCycle()
 
 				// "debiet" (Dutch: flow) = the node's rated capacity scaled by its
 				// current airflow position%, in the same m3/h unit as the capacity.
-				const auto capIt = m_nodeCapacityM3h.find(node.nodeId);
-				if (capIt != m_nodeCapacityM3h.end())
+				int cachedCapacity = -1;
 				{
-					const float flow = (float)capIt->second * ((float)node.flowPercent / 100.0F);
+					std::lock_guard<std::mutex> cacheLock(m_nodeConfigCacheMutex);
+					const auto capIt = m_nodeCapacityM3h.find(node.nodeId);
+					if (capIt != m_nodeCapacityM3h.end())
+						cachedCapacity = capIt->second;
+				}
+				if (cachedCapacity >= 0)
+				{
+					const float flow = (float)cachedCapacity * ((float)node.flowPercent / 100.0F);
 					SendCustomSensor(
 						StableNodeIdForCapability(node.nodeId, SensorCapability::Flow),
 						1,
@@ -913,12 +919,20 @@ void CDucoBoxSerial::PublishNodeConfig(const int nodeId)
 		PublishConfigParam(nodeId, CfgNode, p);
 		// Cache the valve's rated capacity (m3/h) so PollCycle can derive the Flow
 		// device (capacity x airflow%) every cycle without re-reading config.
+		// PublishNodeConfig() can run on either Do_Work() or the Domoticz worker
+		// thread (via WriteToHardware), so this cache needs its own lock.
 		if (p.unit == "m3/h" && ToLower(p.name) == "capacity")
+		{
+			std::lock_guard<std::mutex> cacheLock(m_nodeConfigCacheMutex);
 			m_nodeCapacityM3h[nodeId] = p.value;
+		}
 		// Cache AutoMax (%) as a sane default overrule value for stuck-humidity
 		// remediation -- see IssueNodeOverrule/TrackAndMaybeRemediateStuckHumidity.
 		if (p.unit == "%" && ToLower(p.name) == "automax")
+		{
+			std::lock_guard<std::mutex> cacheLock(m_nodeConfigCacheMutex);
 			m_nodeAutoMaxPercent[nodeId] = p.value;
+		}
 	}
 }
 
@@ -1018,8 +1032,9 @@ void CDucoBoxSerial::TrackAndMaybeRemediateStuckHumidity(const int nodeId, const
 	const time_t now = mytime(nullptr);
 	auto& tracker = m_rhStuckTracker[nodeId];
 
-	if (rhRaw != tracker.lastRawValue)
+	if (!tracker.hasValue || rhRaw != tracker.lastRawValue)
 	{
+		tracker.hasValue = true;
 		tracker.lastRawValue = rhRaw;
 		tracker.sameSince = now;
 		return;
@@ -1028,7 +1043,7 @@ void CDucoBoxSerial::TrackAndMaybeRemediateStuckHumidity(const int nodeId, const
 	const time_t stuckDuration = now - tracker.sameSince;
 	const int humidity = (int)std::lround(rhRaw / 100.0);
 
-	if (humidity < DUCO_RH_STUCK_MIN_PERCENT || stuckDuration < DUCO_RH_STUCK_MIN_DURATION_SECONDS)
+	if (stuckDuration < DUCO_RH_STUCK_MIN_DURATION_SECONDS)
 		return;
 
 	if (m_pendingOverruleRelease.find(nodeId) != m_pendingOverruleRelease.end())
@@ -1042,9 +1057,12 @@ void CDucoBoxSerial::TrackAndMaybeRemediateStuckHumidity(const int nodeId, const
 		nodeId, humidity, rhRaw, (long)(stuckDuration / 60));
 
 	int overrideValue = DUCO_RH_STUCK_DEFAULT_OVERRIDE_PCT;
-	const auto autoMaxIt = m_nodeAutoMaxPercent.find(nodeId);
-	if (autoMaxIt != m_nodeAutoMaxPercent.end() && autoMaxIt->second > 0 && autoMaxIt->second <= 100)
-		overrideValue = autoMaxIt->second;
+	{
+		std::lock_guard<std::mutex> cacheLock(m_nodeConfigCacheMutex);
+		const auto autoMaxIt = m_nodeAutoMaxPercent.find(nodeId);
+		if (autoMaxIt != m_nodeAutoMaxPercent.end() && autoMaxIt->second > 0 && autoMaxIt->second <= 100)
+			overrideValue = autoMaxIt->second;
+	}
 
 	m_lastStuckRemediation[nodeId] = now;
 
@@ -1097,10 +1115,18 @@ void CDucoBoxSerial::CheckPendingOverruleReleases()
 		{
 			const int nodeId = it->first;
 			if (IssueNodeOverrule(nodeId, DUCO_OVERRULE_RELEASE))
+			{
 				Log(LOG_STATUS, "DucoBox: node %d released back to Auto after stuck-RH remediation", nodeId);
+				it = m_pendingOverruleRelease.erase(it);
+			}
 			else
-				Log(LOG_ERROR, "DucoBox: node %d release-to-Auto failed after stuck-RH remediation", nodeId);
-			it = m_pendingOverruleRelease.erase(it);
+			{
+				// Keep the entry and retry next cycle rather than abandoning the node
+				// in manual override -- a failed release (e.g. a serial hiccup) must
+				// not be the last word.
+				Log(LOG_ERROR, "DucoBox: node %d release-to-Auto failed after stuck-RH remediation, will retry", nodeId);
+				++it;
+			}
 		}
 		else
 			++it;
@@ -1162,7 +1188,13 @@ bool CDucoBoxSerial::SendCommand(const std::string& command, const std::string&
 		sleep_milliseconds(DUCO_COMMAND_RETRY_DELAY_MS);
 	}
 
-	return !outRaw.empty();
+	// All retries exhausted without ever seeing a completion marker: report this
+	// as a real failure rather than success-if-any-bytes-arrived. A garbled
+	// partial reply (e.g. async log frames interleaved right as a command was
+	// sent) previously came back as "success", which could silently wipe
+	// probe/config state downstream (callers still see whatever landed in
+	// outRaw, they just no longer get told it's trustworthy).
+	return false;
 }
 
 bool CDucoBoxSerial::ReadNodeParameter(const int nodeId, const int paraId, int& valueOut, int retries)
diff --git a/hardware/DucoBoxSerial.h b/hardware/DucoBoxSerial.h
index 78d0d7d8c..cd0f0cabc 100644
--- a/hardware/DucoBoxSerial.h
+++ b/hardware/DucoBoxSerial.h
@@ -171,6 +171,13 @@ private:
 	bool m_configProbeDone = false;
 	time_t m_lastConfigReadTime = 0;
 	std::map<int, SensorProbeResult> m_sensorProbeCache;
+	// Protects m_nodeCapacityM3h/m_nodeAutoMaxPercent: PublishNodeConfig() writes
+	// them from either Do_Work() (PollCycle) or the Domoticz worker thread (via
+	// WriteToHardware -> WriteConfigValue), while PollCycle()/
+	// TrackAndMaybeRemediateStuckHumidity() read them from Do_Work() -- unlike the
+	// serial port itself (m_commandMutex), plain std::map access here isn't
+	// otherwise synchronised.
+	mutable std::mutex m_nodeConfigCacheMutex;
 	// Cached per-node Capacity (m3/h, nodeconfig index 3 on valves) so the Flow device
 	// can be computed every poll cycle without re-reading config each time.
 	std::map<int, int> m_nodeCapacityM3h;
@@ -194,7 +201,13 @@ private:
 	// fan-near-max heuristics both fire constantly on ordinary shower use).
 	struct StuckHumidityTracker
 	{
-		int lastRawValue = -1;
+		// Explicit "no reading yet" flag rather than a sentinel raw value: -1 is a
+		// valid (if implausible) raw reading, so a sensor that happens to latch at
+		// exactly -1 would otherwise instant-trigger remediation on the very first
+		// poll after startup (stuckDuration computed from a zero-initialized
+		// sameSince).
+		bool hasValue = false;
+		int lastRawValue = 0;
 		time_t sameSince = 0;
 	};
 	std::map<int, StuckHumidityTracker> m_rhStuckTracker;
