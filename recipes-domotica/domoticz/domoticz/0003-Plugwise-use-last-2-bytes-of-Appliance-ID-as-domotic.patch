 			else if (sname == "maximum_boiler_temperature")
@@ -563,7 +565,7 @@ void CAnnaThermostat::GetMeterDetails()
 				if (!tmpstr.empty())
 				{
 					float temperature = (float)atof(tmpstr.c_str());
-					SendTempSensor(sAnnaMaxBoilerTemperature, 255, temperature, sname);
+					SendTempSensor(applianceIDhex, 255, temperature, sname);
 				}
 			}
 			else if (sname == "boiler_state")
@@ -573,11 +575,11 @@ void CAnnaThermostat::GetMeterDetails()
 				{
 					if (strcmp(tmpstr.c_str(), "on") == 0)
 					{
-						SendSwitch(sAnnaBoilerState, 1, 255, true, 0, sname, m_Name);
+						SendSwitch(applianceIDhex, 1, 255, true, 0, sname, m_Name);
 					}
 					else
 					{
-						SendSwitch(sAnnaBoilerState, 1, 255, false, 0, sname, m_Name);
+						SendSwitch(applianceIDhex, 1, 255, false, 0, sname, m_Name);
 					}
 				}
 			}
@@ -589,11 +591,11 @@ void CAnnaThermostat::GetMeterDetails()
 					if (strcmp(tmpstr.c_str(), "on") == 0)
