-				Log(LOG_NORM, "AnnaTherm: Appliance ID: %s", applianceID.c_str());
+				applianceIDhex = strtoul(applianceID.substr(28,4).c_str(), NULL, 16);
+				Log(LOG_NORM, "AnnaTherm: Appliance ID: %s, %x", applianceID.c_str(), applianceIDhex);
 			}
 		} else {
 			Log(LOG_ERROR, "AnnaTherm: Cannot find appliance ID");
