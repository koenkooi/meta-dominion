 				}
 			}
@@ -622,11 +624,11 @@ void CAnnaThermostat::GetMeterDetails()
 				{
 					if (strcmp(tmpstr.c_str(), "on") == 0)
 					{
-						SendSwitch(sAnnaProximity, 1, 255, true, 0, sname, m_Name);
+						SendSwitch(applianceIDhex, 1, 255, true, 0, sname, m_Name);
 					}
