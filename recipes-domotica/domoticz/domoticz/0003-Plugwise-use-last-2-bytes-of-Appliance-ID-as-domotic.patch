-						SendSwitch(sAnnaProximity, 1, 255, false, 0, sname, m_Name);
+						SendSwitch(applianceIDhex, 1, 255, false, 0, sname, m_Name);
 					}
 				}
 			}
@@ -676,7 +678,7 @@ void CAnnaThermostat::GetMeterDetails()
                 if (!tmpstr.empty())
                 {
                     float level = (float)atof(tmpstr.c_str()) * 100.F;
-                    SendPercentageSensor(sAnnaModulationLevel, 1, 255, level, sname);
+                    SendPercentageSensor(applianceIDhex, 1, 255, level, sname);
                 }
