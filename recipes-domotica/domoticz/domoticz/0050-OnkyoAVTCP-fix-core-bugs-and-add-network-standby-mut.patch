+	// Scale a Domoticz 0-100 dimmer level to/from the receiver's own volume range
+	// (0..volMax, per-zone, reported in the NRI capability XML). volMax<=0 means the
+	// receiver's range for this zone isn't known yet (or the zone genuinely has no volume
+	// control, e.g. this receiver's Zone2 volmax="0") -- pass the value through unscaled
+	// rather than divide by zero.
+	uint8_t ScaleLevelToDevice(uint8_t domoticzLevel, int volMax)
+	{
+		if (volMax <= 0)
+			return domoticzLevel;
+		int raw = (domoticzLevel * volMax + 50) / 100;
+		return static_cast<uint8_t>(std::clamp(raw, 0, volMax));
+	}
+
+	uint8_t ScaleLevelFromDevice(int rawLevel, int volMax)
+	{
+		if (volMax <= 0)
+			return static_cast<uint8_t>(std::clamp(rawLevel, 0, 255));
+		int level = (rawLevel * 100 + volMax / 2) / volMax;
+		return static_cast<uint8_t>(std::clamp(level, 0, 100));
+	}
+
+	// TFR (bass/treble) uses a sign character plus a single hex digit for its two values --
+	// confirmed live: TFRQSTN -> "TFRB00T00" at zero. "00" at zero (no sign), otherwise
+	// "-1".."-A" / "+1".."+A" for the documented -10..+10 range.
+	std::string FormatSignedNibble(int value)
+	{
+		value = std::clamp(value, -10, 10);
+		if (value == 0)
+			return "00";
+		char digit[2];
+		snprintf(digit, sizeof(digit), "%X", std::abs(value));
+		return std::string(value > 0 ? "+" : "-") + digit;
+	}
+
+	int ParseSignedNibble(const char *tok)
+	{
+		if (tok[0] == '0' && tok[1] == '0')
+			return 0;
+		int magnitude = strtol(tok + 1, nullptr, 16);
+		return tok[0] == '-' ? -magnitude : magnitude;
+	}
